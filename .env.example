# Server-side AWS configuration. Never expose these with a NEXT_PUBLIC_ prefix.
AWS_REGION=us-east-1

# Optional default override. May be a foundation model ID or inference profile ID.
BEDROCK_MODEL_ID=

# Catalog-verified configuration slots; choose a profile appropriate for your Region.
BEDROCK_OPUS_48_MODEL_ID=
BEDROCK_OPUS_5_MODEL_ID=
BEDROCK_OPUS_55_MODEL_ID=
BEDROCK_SONNET_55_MODEL_ID=
BEDROCK_HAIKU_55_MODEL_ID=
